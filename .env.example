# Gemini is the only inference provider. Set your key locally; never commit .env.
MODE=llm
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Space calls across the evaluator and included math API. Set using your actual quota.
GEMINI_REQUEST_INTERVAL_SECONDS=13
# Optional different Gemini judge model; defaults to GEMINI_MODEL.
JUDGE_MODEL=
# Explicit host allowlist for CHATBOT targets, never '*'. Add your private hostname.
ALLOWED_TARGET_HOSTS=127.0.0.1,localhost,::1
# Optional chatbot credential: choose this VARIABLE NAME in the dashboard.
CHATBOT_API_KEY=
# Values in USD per million tokens, only if known for your target chatbot.
TARGET_INPUT_PRICE_PER_MILLION=
TARGET_OUTPUT_PRICE_PER_MILLION=
GREENLIT_DATA_DIR=data
