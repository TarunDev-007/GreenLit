# Local Ollama mode: no API key. Run ollama pull llama3.2:3b if needed.
MODE=llm
LLM_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional cloud providers: set LLM_PROVIDER=gemini or openai.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# OpenAI-compatible provider settings (unused for Ollama).
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
# Optional separate judge; defaults to the generator model.
JUDGE_MODEL=
# Explicit host allowlist for CHATBOT targets, never '*'. Add your private hostname.
ALLOWED_TARGET_HOSTS=127.0.0.1,localhost,::1
# Optional chatbot credential: choose this VARIABLE NAME in the dashboard.
CHATBOT_API_KEY=
# Values in USD per million tokens, only if known for your target chatbot.
TARGET_INPUT_PRICE_PER_MILLION=
TARGET_OUTPUT_PRICE_PER_MILLION=
GREENLIT_DATA_DIR=data
